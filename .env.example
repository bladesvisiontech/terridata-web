# ---------------------------------------------------------------
# Terridata — variables de entorno
# Copiar a .env.local para desarrollo y definir en Vercel para
# producción. Este archivo sí se versiona; .env.local no.
# ---------------------------------------------------------------

# URL pública del sitio. Se usa para metadatos, Open Graph y sitemap.
NEXT_PUBLIC_SITE_URL=https://terridata.com.co

# Origen de la plataforma, destino de "Soy Ciudadano" y "Soy Funcionario".
#
# Hoy la plataforma vive en la raíz del dominio. Cuando se ejecute la
# migración descrita en docs/migracion-dominio.md, este valor pasa a
# https://app.terridata.com.co y los botones apuntan solos.
NEXT_PUBLIC_PLATFORM_ORIGIN=https://terridata.com.co

# ---------------------------------------------------------------
# Formulario de contacto (pendiente — fase siguiente)
# ---------------------------------------------------------------

# Clave de API de Resend para el envío del formulario.
# RESEND_API_KEY=

# Correo institucional destino del formulario.
# PENDIENTE: confirmar la dirección real con Terridata.
# CONTACT_INBOX=

# Cloudflare Turnstile, para frenar el envío automatizado.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
